APP_NAME="Ecohydrotech Training Management System"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_32_BYTE_APP_KEY
APP_DEBUG=false
APP_URL=https://training.ecohydrotech.com.my
SERVER_NAME=training.ecohydrotech.com.my

APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Kuala_Lumpur
APP_CURRENCY=MYR

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_MY
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

TRUSTED_PROXIES=*

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=etms
DB_USERNAME=etms
DB_PASSWORD=REPLACE_WITH_STRONG_MYSQL_APP_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_STRONG_MYSQL_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=training.ecohydrotech.com.my

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=etms_prod_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="no-reply@ecohydrotech.com.my"
MAIL_FROM_NAME="Ecohydrotech Training Portal"
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
POSTMARK_API_KEY=

# Company Server Private Storage, FFmpeg HLS Streaming & Off-Primary Backups
ETMS_STORAGE_ROOT=/srv/etms/storage
ETMS_MAX_UPLOAD_KB=2097152
ETMS_MEDIA_SIGNING_KEY=REPLACE_WITH_STRONG_64_CHAR_HEX_SECRET
ETMS_VIDEO_TOKEN_TTL_SECONDS=3600
ETMS_HLS_SEGMENT_SECONDS=6
FFMPEG_BINARY=/usr/bin/ffmpeg
FFPROBE_BINARY=/usr/bin/ffprobe
ETMS_X_ACCEL_ENABLED=true
ETMS_X_ACCEL_PREFIX=/_etms_internal_storage
ETMS_BACKUP_ROOT=/srv/etms/backups
ETMS_BACKUP_RETENTION_DAYS=30

# Payment Gateway (Live Billplz Production Credentials)
BILLPLZ_API_KEY=REPLACE_WITH_LIVE_BILLPLZ_API_KEY
BILLPLZ_COLLECTION_ID=REPLACE_WITH_LIVE_BILLPLZ_COLLECTION_ID
BILLPLZ_X_SIGNATURE_KEY=REPLACE_WITH_LIVE_BILLPLZ_X_SIGNATURE_KEY
BILLPLZ_SANDBOX=false

VITE_APP_NAME="${APP_NAME}"
